# --- Kotlin ---
.kotlin/

# --- Per-developer config ---
# Android analog of the iOS LocalAppConfig.swift pattern, with one
# deliberate difference: iOS commits the file with nil defaults and asks
# each dev to `git update-index --skip-worktree` it. That leaked a real LAN
# IP into the iOS repo. Here the file is gitignored from creation and a
# .template is committed instead, so a developer's LAN address can never
# reach a commit.
app/src/main/java/**/LocalAppConfig.kt
local.config.properties

# --- Secrets / signing ---
*.jks
*.keystore
google-services.json
keystore.properties

# Env files, including editor/OS backup variants. The sibling nemara-backend
# repo was hit by exactly this: a local .env.bak was swept into origin/main and
# the keys are still unrotated. The .bak/.local/.save patterns matter as much as
# .env itself — those are the ones nobody thinks to check.
.env
.env.*
*.env
!.env.template
!.env.example

# Cloud-sync conflict copies. OneDrive/iCloud drop "Foo 2.kt" beside "Foo.kt"
# inside the source set, which breaks compileDebugKotlin with redeclaration
# errors that look like a real bug. Happened 2026-08-03 with
# `analytics/BufferedAnalytics 2.kt`. Ignoring them keeps them out of a commit;
# they still have to be moved out of the tree to build.
*[0-9].kt
*[0-9].kts
