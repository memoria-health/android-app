<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      iOS declares the equivalents as Info.plist usage descriptions
      (NSCameraUsageDescription, NSMicrophoneUsageDescription) and the OS
      prompts on first use. Android needs BOTH a manifest declaration and a
      runtime request; a missing declaration makes the runtime request fail
      silently, which is why neither talk mode nor enrollment worked before
      this. See ui/permissions/.

      INTERNET is normal-protection and granted at install; it is declared
      because without it every request fails with a bare SecurityException that
      reads like a network outage.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Talk mode: publishing the caregiver's voice to the room. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Face enrollment and the patient profile photo. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Push notifications. iOS asks for the equivalent at launch through
      UNUserNotificationCenter and needs nothing in Info.plist.

      Android 13 (API 33) turned notifications into a runtime permission. Below
      33 this line is ignored and notifications are on by default, so the app
      behaves as it always did on older phones. From 33 up, a missing
      declaration makes the runtime request fail silently — the same trap that
      left talk mode and enrollment unusable before D13 — and the app would post
      notifications that never appear anywhere.

      Where the app asks for it, and why there, is in MainShell.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Declared NOT required so the app stays installable on a device with no
      camera. Enrollment is one flow, not the product, and iOS does not gate
      installation on a camera either.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".MemoriaApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Memoria">

        <!--
          iOS is portrait-only and phone-only (PARITY.md §1). Match it.

          launchMode="singleTop" is required by the recovery link below, not a
          preference. Under the default ("standard") mode, tapping the link in
          the email app while Memoria is already running starts a SECOND
          MainActivity on top of the first: onNewIntent never fires, the
          caregiver resets their password in a duplicate copy of the app, and
          Back reveals the stale one underneath. singleTop hands the link to the
          instance that is already on top of the task instead, which is what
          makes the onNewIntent path below reachable at all. Nothing else in the
          app depends on being re-created per intent, so there is no cost.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Memoria">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The password-recovery link. Supabase sends the caregiver an email
              whose button opens `AppConfig.supabasePasswordResetRedirect` —
              `nemara://reset-password?code=…` — which is the same scheme and
              host iOS registers in `project.yml` (CFBundleURLSchemes: nemara).
              Both halves must match the redirect exactly or the link opens
              nothing, which is the state this app was in: the email sent, the
              tap resolved to no app, and password recovery was impossible.

              BROWSABLE is what lets a link *in a browser or email client* start
              us; without it only another app calling startActivity could. It
              does mean any app can launch this screen with an arbitrary code,
              which is true of the iOS scheme too and is harmless: a code that
              Supabase did not mint fails the exchange and the screen says so.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nemara" android:host="reset-password" />
            </intent-filter>
        </activity>

        <!--
          Where FCM delivers. iOS gets both of this service's jobs from
          AppDelegate callbacks the OS calls on the app object itself; Android
          requires a declared component, and without this <service> the token
          callback and every data message go nowhere at all.

          exported="false" because only the system may start it. The action
          below is what Firebase's own manifest binds to, and it is the whole of
          the contract — the name of the class is ours.
        -->
        <service
            android:name=".push.MemoriaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          The three below cover the path our code never sees.

          A message that carries a `notification` block and arrives while the app
          is backgrounded is drawn by the system directly: onMessageReceived is
          never called, so NotificationChannels and EventNotifications have no
          say in how it looks. Without these, such a notification lands in
          Android's unnamed "Miscellaneous" channel — which the caregiver's own
          "Alerts" setting does not control — with the raw launcher icon and no
          accent colour.

          The channel id is the SAME string resource NotificationChannels reads,
          so the channel named here is always the channel the app creates.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_alerts_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_push_alert" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/terra" />
    </application>

</manifest>
