<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only cleartext policy. Spec: PARITY.md §4, DIFFERENCES.md D5.

  iOS gets this from NSAllowsLocalNetworking: plain HTTP is permitted to
  non-routable addresses, while routable destinations still require TLS. The
  equivalent on Android is a network security config, and it lives in the debug
  source set so the release build never merges it and keeps the platform
  default of no cleartext anywhere.

  Android's config matches hostnames and literal IP addresses. It has no way to
  express an address range, so "private addresses only" cannot be written as
  10.0.0.0/8 and the hosts a debug build actually talks to are listed one by
  one instead. Everything else, including the whole public internet, still
  requires TLS even in debug.

  Working from a physical device against your own machine? Add your LAN IP as
  another domain entry. That address is private, so it belongs to the same
  class of destination as the ones already here.
-->
<network-security-config>

    <!-- Everything not named below keeps the platform default: TLS required. -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- The address the emulator gives the guest for the host machine's
             loopback. This is where the local backend and local Supabase are,
             and it is the debug fallback in AppConfig. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- The device or emulator itself, for anything served on-device. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

</network-security-config>
